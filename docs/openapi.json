            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Source Hive Ids"
          },
          "extracted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Extracted At"
          },
          "quantity_kg": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,7}|(?=[\\d.]{1,11}0*$)\\d{0,7}\\.\\d{0,3}0*$)"
              }
            ],
            "title": "Quantity Kg"
          },
          "honey_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Honey Type"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
